# LaTeX build artifacts — must NOT be committed.
# Committing latexmk's database (*.fdb_latexmk) / file list (*.fls) / stale *.aux
# makes Overleaf skip bibtex, which breaks all citations and the reference list.
*.aux
*.bbl
*.blg
*.log
*.out
*.pdf
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
